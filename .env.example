# --- Database -------------------------------------------------------
# Local: Docker Compose. Hosted: a Neon connection string.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/arxiv_db

# --- Cache and job state --------------------------------------------
# Local: Docker Compose. Hosted: an Upstash rediss:// URL.
REDIS_URL=redis://localhost:6379/2

# --- OpenAI ---------------------------------------------------------
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]
OPENAI_MODEL=gpt-4.1-mini

# 384 dimensions keeps the existing pgvector column and index.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# --- Reranking (optional) -------------------------------------------
# Without a key the pipeline falls back to fusion ordering.
COHERE_API_KEY=
RERANKER_MODEL=rerank-v3.5
RERANKER_TIMEOUT_SECONDS=15

# --- Sessions -------------------------------------------------------
SESSION_TTL_SECONDS=7200
MAX_PAPERS_PER_SESSION=5

# --- Uploads --------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_UPLOAD_PAGES=80

# --- Jobs -----------------------------------------------------------
JOB_TTL_SECONDS=3600
JOB_STALE_AFTER_SECONDS=300

# --- Cache ----------------------------------------------------------
ANSWER_CACHE_TTL_SECONDS=3600
QUERY_EMBEDDING_CACHE_TTL_SECONDS=86400
CACHE_KEY_PREFIX=arxiv-rag

# --- Rate limits ----------------------------------------------------
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=7200
INGESTION_RATE_LIMIT_REQUESTS=3
INGESTION_RATE_LIMIT_WINDOW_SECONDS=7200
SESSION_CREATE_RATE_LIMIT_REQUESTS=10
SESSION_CREATE_RATE_LIMIT_WINDOW_SECONDS=86400

# --- Frontend -------------------------------------------------------
# Comma-separated. Add the deployed Vercel URL before going live.
FRONTEND_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

